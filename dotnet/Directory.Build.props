<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors>nullable</WarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Authors>M4TK</Authors>
    <Company>M4TK</Company>
    <Product>vUSOS</Product>
    <Copyright>GPL-3.0</Copyright>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>pl;en</SatelliteResourceLanguages>
  </PropertyGroup>
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <NoWarn>$(NoWarn);CA1707;CA2007;CA1861;CA1848;CA1849;CA2234;CA1054;CA1056;CA1062;CA1303</NoWarn>
  </PropertyGroup>
</Project>
