@page "/ustawienia"
@implements IDisposable
@inject IConnectionManager Connections
@inject IConnectFlows Flows
@inject IMaterialService Materials
@inject IQuizService Quizzes
@inject ISyncStatus Sync
@inject IAuthSession Auth
@inject ToastService Toasts
@inject IServiceProvider Services

<PageTitle>Ustawienia – vUSOS</PageTitle>
<PageHeader Title="Ustawienia" Subtitle="Połączenia, pamięć offline, konto" />

<div class="settings-grid">
    <Card Title="Konto" IconName="user">
        @if (Auth.IsSignedIn)
        {
            <p><strong>@(Auth.DisplayName ?? "Zalogowany użytkownik")</strong></p>
            @if (!string.IsNullOrEmpty(Auth.Email)) { <p class="muted">@Auth.Email</p> }
            @if (!Auth.SupportsExternalIdentityProvider)
            {
                <p class="muted small">Tożsamość pochodzi z połączenia z USOS lub Platonem (konto M365 uczelni).</p>
            }
            <p><button type="button" class="btn" @onclick="() => _confirmLogout = true"><Icon Name="log-out" Size="16" /> Wyloguj</button></p>
        }
        else
        {
            <p><strong>Niezalogowano</strong></p>
            <p class="muted small">Połącz Platon lub USOS (kontem M365 uczelni) – zalogujesz się automatycznie.</p>
        }
    </Card>

    <Card Title="USOS" IconName="grades">
        <Actions>@StatusBadge(SourceSystem.Usos)</Actions>
        <ChildContent>
            @ConnectionDetails(SourceSystem.Usos)
            <div class="btn-row">
                <button type="button" class="btn btn-primary" @onclick="ConnectUsos" disabled="@Busy("usos")">
                    <Icon Name="plug" Size="16" /> @(IsConnected(SourceSystem.Usos) ? "Połącz ponownie z USOS" : "Połącz z USOS")
                </button>
                @if (CanDisconnect(SourceSystem.Usos)) { <button type="button" class="btn" @onclick="() => _confirmDisconnect = SourceSystem.Usos">Rozłącz</button> }
            </div>
            <p class="muted small">Otworzy się przeglądarka z logowaniem kontem uczelni. Po zalogowaniu wrócisz do aplikacji.</p>
            <ConnectForms Target="SourceSystem.Usos" OnConnected="RefreshAsync" />
        </ChildContent>
    </Card>

    <Card Title="Platon" IconName="book">
        <Actions>@StatusBadge(SourceSystem.Platon)</Actions>
        <ChildContent>
            @ConnectionDetails(SourceSystem.Platon)
            <div class="btn-row">
                <button type="button" class="btn btn-primary" @onclick="ConnectPlaton" disabled="@Busy("platon")">
                    <Icon Name="plug" Size="16" /> @(IsConnected(SourceSystem.Platon) ? "Połącz ponownie z Platonem" : "Połącz z Platonem")
                </button>
                @if (CanDisconnect(SourceSystem.Platon)) { <button type="button" class="btn" @onclick="() => _confirmDisconnect = SourceSystem.Platon">Rozłącz</button> }
            </div>
            <p class="muted small">Jedno kliknięcie: logujesz się kontem uczelni, a aplikacja sama odbiera token dostępu.</p>
            <ConnectForms Target="SourceSystem.Platon" OnConnected="RefreshAsync" />
        </ChildContent>
    </Card>

    <Card Title="Pamięć offline" IconName="download">
        <p>Pobrane materiały zajmują <strong>@Fmt.Bytes(_totalSize)</strong>@(_fileCount > 0 ? $" ({_fileCount} {Fmt.Plural(_fileCount, "plik", "pliki", "plików")})" : "").</p>
        <p class="muted small">Pobrane pliki otwierają się bez internetu. Usunięcie ich z urządzenia nie usuwa niczego z Platona.</p>
        <button type="button" class="btn" @onclick="() => _confirmClear = true" disabled="@(_fileCount == 0 && _totalSize == 0)"><Icon Name="trash" Size="16" /> Wyczyść pobrane</button>
    </Card>

    <Card Title="Synchronizacja" IconName="refresh">
        @{ var pending = Sync.Get(SourceSystem.Usos).PendingActions + Sync.Get(SourceSystem.Platon).PendingActions; }
        @if (pending == 0)
        {
            <p>Wszystko zsynchronizowane.</p>
        }
        else
        {
            <p><strong>@pending</strong> @Fmt.Plural(pending, "zmiana czeka", "zmiany czekają", "zmian czeka") na wysłanie (np. odpowiedzi w testach zapisane offline).</p>
            <button type="button" class="btn btn-primary" @onclick="SyncNowAsync" disabled="@_syncing">@(_syncing ? "Synchronizacja…" : "Synchronizuj teraz")</button>
        }
    </Card>

    <Card Title="O aplikacji" IconName="info">
        <p>vUSOS – @(University?.Name ?? "uczelniana platforma studenta")</p>
        <p class="muted small">Aplikacja nieoficjalna. Dane i poświadczenia są przechowywane wyłącznie na Twoim urządzeniu. Aplikacja nigdy nie prosi o hasło uczelniane.</p>
    </Card>
</div>

<Dialog Open="_confirmLogout" OnClose="() => _confirmLogout = false" Title="Wylogować?">
    <ChildContent>
        @if (Auth.SupportsExternalIdentityProvider)
        {
            <p>Wylogowanie z aplikacji zakończy sesję na tym urządzeniu. Dane zapisane lokalnie mogą zostać usunięte.</p>
        }
        else
        {
            <p>Wylogowanie rozłączy USOS i Platon oraz usunie z tego urządzenia zapisane dane (cache i pobrane materiały). Aby wrócić, połącz systemy ponownie.</p>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="btn" @onclick="() => _confirmLogout = false">Anuluj</button>
        <button type="button" class="btn btn-primary" @onclick="LogoutAsync">Wyloguj</button>
    </Footer>
</Dialog>

<Dialog Open="_confirmDisconnect is not null" OnClose="() => _confirmDisconnect = null" Title="@($"Rozłączyć {(_confirmDisconnect is { } cd ? Fmt.SystemName(cd) : "")}?")">
    <ChildContent><p>Poświadczenia zostaną usunięte z urządzenia. Zapisane dane nadal będą dostępne offline.</p></ChildContent>
    <Footer>
        <button type="button" class="btn" @onclick="() => _confirmDisconnect = null">Anuluj</button>
        <button type="button" class="btn btn-primary" @onclick="DisconnectAsync">Rozłącz</button>
    </Footer>
</Dialog>

<Dialog Open="_confirmClear" OnClose="() => _confirmClear = false" Title="Wyczyścić pobrane pliki?">
    <ChildContent><p>Usuniesz z urządzenia wszystkie pobrane materiały (@Fmt.Bytes(_totalSize)). Później możesz pobrać je ponownie.</p></ChildContent>
    <Footer>
        <button type="button" class="btn" @onclick="() => _confirmClear = false">Anuluj</button>
        <button type="button" class="btn btn-primary" @onclick="ClearAsync">Wyczyść</button>
    </Footer>
</Dialog>

@code {
    private IReadOnlyDictionary<SourceSystem, ConnectionInfo> _status = new Dictionary<SourceSystem, ConnectionInfo>();
    private readonly HashSet<string> _busy = [];
    private readonly Dictionary<string, string> _errors = [];
    private long _totalSize;
    private int _fileCount;
    private bool _syncing, _confirmLogout, _confirmClear;
    private SourceSystem? _confirmDisconnect;

    private UniversityOptions? University => Services.GetService<Microsoft.Extensions.Options.IOptions<UniversityOptions>>()?.Value;

    protected override async Task OnInitializedAsync()
    {
        Connections.Changed += OnChanged;
        Sync.Changed += OnSync;
        Auth.Changed += OnAuth;
        await RefreshAsync();
    }

    private void OnChanged(object? sender, SourceSystem s) => _ = InvokeAsync(async () => { await RefreshAsync(); StateHasChanged(); });
    private void OnSync(object? sender, SyncState s) => _ = InvokeAsync(StateHasChanged);
    private void OnAuth() => _ = InvokeAsync(StateHasChanged);

    private async Task RefreshAsync()
    {
        try { _status = await Connections.GetStatusAsync(); } catch (Exception) { }
        try
        {
            _totalSize = await Materials.GetTotalSizeAsync();
            _fileCount = (await Materials.ListAsync()).Count(m => m.State == DownloadState.Done);
        }
        catch (Exception) { }
    }

    private Task ConnectUsos() => RunAsync("usos", Flows.StartUsosAsync, "Dokończ logowanie do USOS w przeglądarce. Po powrocie status odświeży się automatycznie.");
    private Task ConnectPlaton() => RunAsync("platon", Flows.StartPlatonAsync, "Dokończ logowanie do Platona w przeglądarce. Po powrocie status odświeży się automatycznie.");

    private bool Busy(string key) => _busy.Contains(key);

    private RenderFragment ErrorFor(string key) => __builder =>
    {
        if (_errors.TryGetValue(key, out var message))
        {
            <p class="text-danger small" role="alert">@message</p>
        }
    };

    private async Task RunAsync(string key, Func<Task> action, string successMessage, Action? onSuccess = null)
    {
        _busy.Add(key);
        _errors.Remove(key);
        try
        {
            await action();
            onSuccess?.Invoke();
            Toasts.Success(successMessage);
            await RefreshAsync();
        }
        catch (Exception e) { _errors[key] = e.Message; }
        _busy.Remove(key);
    }

    private ConnectionInfo? Info(SourceSystem s) => _status.TryGetValue(s, out var i) ? i : null;
    private bool IsConnected(SourceSystem s) => Info(s)?.Status == ConnectionStatus.Connected;
    private bool CanDisconnect(SourceSystem s) => Info(s) is { Status: not ConnectionStatus.Disconnected };

    private RenderFragment StatusBadge(SourceSystem s) => __builder =>
    {
        var st = Info(s)?.Status ?? ConnectionStatus.Disconnected;
        var (tone, label) = st switch
        {
            ConnectionStatus.Connected => ("ok", "Połączono"),
            ConnectionStatus.Expired => ("warn", "Sesja wygasła"),
            ConnectionStatus.Error => ("danger", "Błąd połączenia"),
            _ => ("neutral", "Niepołączono"),
        };
        <Badge Tone="@tone">@label</Badge>
    };

    private RenderFragment ConnectionDetails(SourceSystem s) => __builder =>
    {
        var info = Info(s);
        if (info is null || info.Status == ConnectionStatus.Disconnected) return;
        <p class="muted small">
            Tryb: @ModeLabel(info.Mode)
            @if (info.UpdatedAt is { } at) { <text> · zaktualizowano @Fmt.DateTime(at)</text> }
        </p>
        if (!string.IsNullOrEmpty(info.Error))
        {
            <p class="text-danger small">@info.Error</p>
        }
    };

    private static string ModeLabel(string mode) => mode.ToLowerInvariant() switch
    {
        "api" or "oauth" => "USOS API (OAuth)",
        "web" => "tryb awaryjny (cookies)",
        "ws" => "Web Services (token)",
        "mock" => "dane demonstracyjne",
        _ => mode,
    };

    private async Task DisconnectAsync()
    {
        var system = _confirmDisconnect;
        _confirmDisconnect = null;
        if (system is null) return;
        try
        {
            await Connections.DisconnectAsync(system.Value);
            Toasts.Show($"Rozłączono {Fmt.SystemName(system.Value)}.");
            await RefreshAsync();
        }
        catch (Exception e) { Toasts.Error(e.Message); }
    }

    private async Task ClearAsync()
    {
        _confirmClear = false;
        try
        {
            foreach (var m in await Materials.ListAsync()) await Materials.RemoveAsync(m.Id);
            Toasts.Success("Usunięto pobrane pliki.");
            await RefreshAsync();
        }
        catch (Exception e) { Toasts.Error(e.Message); }
    }

    private async Task SyncNowAsync()
    {
        _syncing = true;
        try
        {
            var n = await Quizzes.SyncPendingAsync();
            Toasts.Success(n == 0 ? "Nic do synchronizacji." : $"Zsynchronizowano: {n}.");
        }
        catch (Exception e) { Toasts.Error("Synchronizacja nie powiodła się: " + e.Message); }
        _syncing = false;
    }

    private async Task LogoutAsync()
    {
        _confirmLogout = false;
        try { await Auth.SignOutAsync(); }
        catch (Exception e) { Toasts.Error(e.Message); }
    }

    public void Dispose()
    {
        Connections.Changed -= OnChanged;
        Sync.Changed -= OnSync;
        Auth.Changed -= OnAuth;
    }
}
