@implements IDisposable
@inject ToastService Service

<div class="toasts" aria-live="polite" aria-atomic="false">
    @foreach (var t in Service.Items)
    {
        var id = t.Id;
        <div class="toast toast-@t.Kind.ToString().ToLowerInvariant()" role="status">
            <span>@t.Message</span>
            <button type="button" class="icon-btn" @onclick="() => Service.Dismiss(id)" aria-label="Zamknij powiadomienie"><Icon Name="x" Size="16" /></button>
        </div>
    }
</div>

@code {
    protected override void OnInitialized() => Service.Changed += OnChanged;
    private void OnChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Service.Changed -= OnChanged;
}
