<div class="empty">
    @if (!string.IsNullOrEmpty(IconName)) { <Icon Name="@IconName" Size="28" Class="empty-icon" /> }
    <p class="empty-title">@Title</p>
    @if (!string.IsNullOrEmpty(Hint)) { <p class="muted">@Hint</p> }
    @ChildContent
</div>

@code {
    [Parameter] public string Title { get; set; } = "Brak danych";
    [Parameter] public string? Hint { get; set; }
    [Parameter] public string? IconName { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
