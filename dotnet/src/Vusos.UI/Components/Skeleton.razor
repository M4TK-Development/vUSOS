<div class="skeleton-group" role="status" aria-live="polite" aria-label="Wczytywanie">
    @for (var i = 0; i < Rows; i++)
    {
        <div class="skeleton @(Cards ? "skeleton-card" : "skeleton-line")" style="@(Cards ? null : $"width:{Widths[i % Widths.Length]}%")"></div>
    }
    <span class="sr-only">Wczytywanie…</span>
</div>

@code {
    [Parameter] public int Rows { get; set; } = 4;
    /// <summary>Wyższe bloki zamiast linii.</summary>
    [Parameter] public bool Cards { get; set; }
    private static readonly int[] Widths = [100, 82, 94, 68, 88];
}
