<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sandbox aplikacji macOS (wymagany do dystrybucji w App Store) -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Połączenia wychodzące (USOS, Platon, Vusos.Server, logowanie M365) -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Nasłuch na pętli zwrotnej: MSAL odbiera przekierowanie http://localhost po logowaniu M365 -->
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- Otwieranie pobranych materiałów -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
