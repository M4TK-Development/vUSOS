@page "/dev-logowanie"
@layout EmptyLayout
@inject IConfiguration Configuration

<PageTitle>Logowanie deweloperskie – vUSOS</PageTitle>
<div class="login">
    <div class="card login-card">
        <h1>Logowanie deweloperskie</h1>
        <p class="muted">Zastępuje okno logowania Microsoft 365 (Auth:Mode=dev). W wersji produkcyjnej tożsamość potwierdza Entra ID, tutaj wystarczy adres e-mail z domeny uczelni. Każdy adres ma osobne dane.</p>
        @* Zwykły POST do endpointu /auth/dev-login (ustawia cookie sesji), nie zdarzenie Blazora – sesja przetrwa odświeżenie. *@
        <form class="form" method="post" action="/auth/dev-login">
            <input type="hidden" name="returnUrl" value="@(ReturnUrl ?? "/")" />
            <label class="field">
                <span>Adres e-mail</span>
                <input class="input" type="email" name="email" value="@(Configuration["Dev:AutoSignInEmail"] is { Length: > 0 } e ? e : "anna.kowalska@stu.vistula.edu.pl")" required autocomplete="username" inputmode="email" />
            </label>
            @if (!string.IsNullOrEmpty(Error)) { <p class="text-danger small" role="alert">@Error</p> }
            <button type="submit" class="btn btn-primary btn-lg">Zaloguj</button>
            <a class="btn btn-ghost" href="/logowanie">Wróć</a>
        </form>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; }
}
