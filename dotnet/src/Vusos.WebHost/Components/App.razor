<!DOCTYPE html>
<html lang="pl">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#4338ca" />
    <base href="/" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 32 32%27%3E%3Crect width=%2732%27 height=%2732%27 rx=%277%27 fill=%27%234338ca%27/%3E%3Ctext x=%2716%27 y=%2724%27 font-size=%2722%27 font-family=%27sans-serif%27 font-weight=%27700%27 text-anchor=%27middle%27 fill=%27white%27%3Ev%3C/text%3E%3C/svg%3E" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["_content/Vusos.UI/css/app.css"]" />
    <link rel="stylesheet" href="@Assets["Vusos.WebHost.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="InteractiveServerNoPrerender" />
</head>

<body>
    <Routes @rendermode="InteractiveServerNoPrerender" />
    <ReconnectModal />
    <script src="@Assets["_content/Vusos.UI/js/vusos.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    // Bez prerenderingu: dane ładują się raz (po połączeniu obwodu), nie dwa razy. VUSOS_PRERENDER=1 włącza prerendering
    // wyłącznie diagnostycznie (np. curl strony z Dev__AutoSignInEmail, żeby zobaczyć wyrenderowany HTML i wyjątki w logu).
    private static readonly bool Prerender = Environment.GetEnvironmentVariable("VUSOS_PRERENDER") == "1";
    private static readonly IComponentRenderMode InteractiveServerNoPrerender = new InteractiveServerRenderMode(prerender: Prerender);
}
