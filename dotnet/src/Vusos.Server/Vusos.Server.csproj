<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Vusos.Core\Vusos.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- CA5350: HMAC-SHA1 jest wymagany przez OAuth 1.0a; CA1848/CA1873: prosty logging w minimal API. -->
    <NoWarn>$(NoWarn);CA5350;CA1848;CA1873</NoWarn>
  </PropertyGroup>

</Project>
