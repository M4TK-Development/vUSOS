{
  "name": "@vusos/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync": "pnpm --filter @vusos/web build && cap sync",
    "add:android": "cap add android && node scripts/patch-native.mjs",
    "add:ios": "cap add ios && node scripts/patch-native.mjs",
    "android": "cap open android",
    "ios": "cap open ios",
    "run:android": "cap run android",
    "run:ios": "cap run ios",
    "typecheck": "tsc --noEmit",
    "test": "echo 'no tests'"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/browser": "^6.0.4",
    "@capacitor/core": "^6.2.0",
    "@capacitor/ios": "^6.2.0",
    "@capacitor/preferences": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "typescript": "^5.6.3"
  }
}
