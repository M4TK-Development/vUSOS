{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "vUSOS",
  "version": "0.1.0",
  "identifier": "pl.m4tk.vusos",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @vusos/web dev",
    "beforeBuildCommand": "pnpm --filter @vusos/web build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "vUSOS",
        "width": 1280,
        "height": 820,
        "minWidth": 480,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["vusos"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "category": "Education",
    "shortDescription": "Jednolita platforma studenta Vistula",
    "publisher": "M4TK"
  }
}
